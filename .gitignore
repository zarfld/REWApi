# REW API .gitignore
# Following IEEE/ISO/IEC standards-compliant project structure

# =============================================================================
# Build Directories (Standard Build Structure)
# =============================================================================

# Root build directory and all subdirectories
build/
!build/.gitkeep

# Language-specific build outputs
build/cpp/
build/csharp/
build/js/
build/python/

# Build artifacts
build/artifacts/
build/artifacts/packages/
build/artifacts/docs/
build/artifacts/reports/
build/artifacts/coverage/

# =============================================================================
